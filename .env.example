# ---- Pick ONE provider: anthropic | openai | gemini -------------------------
AI_PROVIDER=gemini

# Put the key and model for the provider you chose. Provider-specific names win
# over the shared AI_* names, so you can keep all three keys here and switch
# providers by changing AI_PROVIDER only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=

# Shared fallbacks (used only if the provider-specific value above is empty).
# Leave AI_BASE_URL blank unless you use a proxy: a leftover URL from another
# provider here will send your request to the wrong service.
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

AI_TIMEOUT_MS=120000
AI_MAX_RETRIES=2

BOQ_MAX_TOKENS=16000
BOQ_MAX_PDF_MB=20
BOQ_MAX_JOBS=2

BOQ_DATA=./data
BOQ_JOBS=./data/jobs
BOQ_CACHE=./data/cache
BOQ_RATES=./pricing/rates.csv
BOQ_ASSUMPTIONS=./takeoff/assumptions.toml

# Estimated cost shown in the app (USD per million tokens) - set for YOUR model.
BOQ_PRICE_IN=2
BOQ_PRICE_OUT=10
BOQ_CURRENCY=UGX
BOQ_CORS_ORIGINS=http://localhost:3000

# The main API calls this service with this key. Required in production: without it anyone who can reach this port can spend your AI credit.
BOQ_SERVICE_KEY=
